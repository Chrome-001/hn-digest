# Hacker News API base URL (usually left alone)
HN_API_BASE=https://hacker-news.firebaseio.com/v0

# How many stories to pull and minimum score to include
HN_TOP_LIMIT=30
HN_MIN_SCORE=50

# Where to write the dated reports
OUTPUT_DIR=digest

# GitHub auto-publish (optional; omit to write locally only)
GH_OWNER=
GH_REPO=
GH_TOKEN=
GIT_NAME=hn-digest[bot]
GIT_EMAIL=hn-digest[bot]@users.noreply.github.com